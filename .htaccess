# Apache/LiteSpeed (Hostinger) equivalent of the nginx allowlist in README.md: only the public
# pages, admin pages and assets/ are served; everything else (includes/, backups/, .git, *.sql,
# config.local.php, docs) returns 404. Ignored by nginx and `php -S`.
Options -Indexes
DirectoryIndex index.php

RewriteEngine On

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

RewriteRule ^$ - [L]
RewriteRule ^(index|register|checkin|lookup)\.php$ - [L]
RewriteRule ^admin/[a-z_]+\.php$ - [L]
RewriteRule ^assets/.*\.(php|phar|phtml)$ - [R=404,L]
RewriteRule ^assets/ - [L]
RewriteRule ^ - [R=404,L]
